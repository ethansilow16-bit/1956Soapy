function extractYouTubeId(url) {

  if (typeof url !== "string") return null;

  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|v\/|shorts\/))([\w-]{11})/);

  return match ? match[1] : null;

}



