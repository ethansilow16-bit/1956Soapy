    })();



    ytConstructing = true;

    try {

      ytPlayer = new YT.Player(holder, {

        height: "0",

        width: "0",

        videoId: "",

        playerVars: {

          autoplay: 0,

          controls: 0,

          disablekb: 1,

          fs: 0,

          rel: 0,

          playsinline: 1

        },

        events: {

          onReady: () => {

            if (ytConstructing) {

              ytReadyPending = true;

              return;

            }

            ytPlayerReady = true;

            applyVolumeToYT();

            flushYTCallbacks();

          },

          onStateChange: (e) => {

            if (e.data === YT.PlayerState.ENDED) {

              ytHooks.onEnded?.();

            }

            if (e.data === YT.PlayerState.PLAYING) {

              applyVolumeToYT();

            }

          }

        }

      });

    } catch (e) {

      ytConstructing = false;

      console.log("Could not create the YouTube player.", e);

      return;

    }

    ytConstructing = false;



    if (ytReadyPending) {

      ytReadyPending = false;

      ytPlayerReady = true;

